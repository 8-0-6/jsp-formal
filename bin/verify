#!/usr/bin/env bash
# Full verification gate. Exit 0 only if everything is provably clean.
set -uo pipefail
export PATH="$HOME/.elan/bin:$PATH"
cd "$(dirname "$0")/.."
ROOT=$(pwd); FAIL=0
red(){ printf '\033[31m%s\033[0m\n' "$*"; }; grn(){ printf '\033[32m%s\033[0m\n' "$*"; }
hdr(){ printf '\n\033[1m== %s\033[0m\n' "$*"; }

hdr "1/3  Build"
if lake build 2>&1 | grep -vE 'Downloa|Decompress|^trace:' | tee /tmp/jsp_build.log | grep -qE '^error'; then
  red "BUILD FAILED"; grep -E '^(error|warning)' /tmp/jsp_build.log | head -40; FAIL=1
else
  grn "build ok"
fi

hdr "2/3  Forbidden constructs"
# Only scan the library source, not deps or notes.
PAT='\bsorry\b|\badmit\b|\bnative_decide\b|^\s*axiom\s|\bunsafe\s+(def|theorem)|\bpartial\s+def|@\[implemented_by|Lean\.ofReduceBool|\bsorryAx\b'
if grep -rnE "$PAT" JSPFormal --include='*.lean' ; then
  red "FORBIDDEN CONSTRUCT FOUND"; FAIL=1
else
  grn "no sorry / admit / native_decide / custom axiom / unsafe"
fi

hdr "3/3  Axiom audit (#print axioms)"
# Library name comes from lakefile.toml, NOT the directory basename: the repo
# directory is named differently from the Lean library (jsp-formal vs JSPFormal),
# and a hyphenated directory produces an invalid module name.
MOD=$(awk -F'"' '/^defaultTargets/{print $2; exit}' lakefile.toml)
if [ -z "$MOD" ]; then
  MOD=$(awk -F'"' '/^\[\[lean_lib\]\]/{f=1} f && /^name[[:space:]]*=/{print $2; exit}' lakefile.toml)
fi
if [ -z "$MOD" ]; then red "cannot determine Lean library name from lakefile.toml"; exit 1; fi
TMP=$(mktemp -d); CHK="$TMP/AxiomCheck.lean"
{ echo "import $MOD"; grep -vE '^\s*(#|$)' targets.txt | while read -r t; do echo "#print axioms $t"; done; } > "$CHK"
N=$(grep -cvE '^\s*(#|$)' targets.txt)
if [ "$N" -eq 0 ]; then red "targets.txt is empty: nothing is being verified"; FAIL=1; fi
OUT=$(lake env lean "$CHK" 2>&1)
echo "$OUT" | grep -E "depends on|does not depend" | sed 's/^/  /'
if echo "$OUT" | grep -qE 'sorryAx|error'; then
  red "AXIOM AUDIT FAILED (sorry or error)"; echo "$OUT" | grep -E 'error|sorryAx' | head -20; FAIL=1
elif echo "$OUT" | grep -E 'depends on axioms' | grep -qvE '^\S+ .*\[(propext|Classical\.choice|Quot\.sound)(, (propext|Classical\.choice|Quot\.sound))*\]$'; then
  red "NON-STANDARD AXIOM DEPENDENCY"; FAIL=1
else
  grn "$N/$N targets depend only on standard axioms"
fi
rm -rf "$TMP"

echo
if [ "$FAIL" -eq 0 ]; then grn "════ VERIFIED ════"; else red "════ FAILED ════"; fi
exit $FAIL
